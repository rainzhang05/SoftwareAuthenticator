# Direct dependencies of the Python end-to-end tests. requirements.txt pins
# these and everything they pull in, with hashes; regenerate it with:
#
#   uv pip compile tests/e2e/requirements.in --generate-hashes \
#     --python-version 3.14 --python-platform x86_64-unknown-linux-gnu \
#     -o tests/e2e/requirements.txt
#
# python-fido2: CTAPHID transport, CTAP2 commands and the PIN/UV protocols.
