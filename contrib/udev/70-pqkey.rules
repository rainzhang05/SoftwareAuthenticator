# udev rules for pqkey, the ML-DSA software authenticator.
#
# "pqkey setup" installs these rules (with sudo, once you agree). By hand,
# install with:
#   sudo install -m 644 70-pqkey.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
# and load the uhid module at every boot, so the first rule applies before
# anyone needs the device:
#   echo uhid | sudo tee /etc/modules-load.d/uhid.conf
#
# The file name must sort before 73-seat-late.rules, which is where systemd
# acts on the "uaccess" tag set below, and before the 70-snap.*.rules that
# snapd writes, which act on the snap tags.

ACTION=="remove", GOTO="pqkey_end"

# /dev/uhid, which pqkey opens to create the virtual security key.
# Only root can open it by default. Anyone who can open it can create any
# kind of HID device, keyboards included, and so type into whichever session
# is active: only add users you would trust with that to the group. The group
# is plugdev as on Debian and Ubuntu; create it or pick another group
# elsewhere.
SUBSYSTEM=="misc", KERNEL=="uhid", GROUP="plugdev", MODE="0660"

# The hidraw node of the virtual key itself, which browsers and other FIDO
# clients open.
#
# A device created through /dev/uhid has no USB parent device, so USB
# attributes such as ATTRS{idVendor} never match it. The kernel makes the uhid
# misc device its parent instead, which gives the node a path like
#   /devices/virtual/misc/uhid/0003:1209:0001.0004/hidraw/hidraw3
# where the numbers are the bus (0003, USB), the vendor and product IDs in
# upper-case hex, and an instance counter. 1209:0001 are pqkey's defaults
# (pid.codes' open source vendor ID and a test product ID); change the pattern
# if you pass --vendor-id or --product-id. Real USB security keys never match,
# even with the same IDs.
#
# systemd 244 and later already recognise any hidraw device with a FIDO
# report descriptor, this one included (60-fido-id.rules, 70-uaccess.rules),
# and give the user of the active local session access to it. This rule does
# the same where that is missing, and gives the node mode 0600, so no other
# user can open it through its mode: whoever can open the node can send the
# authenticator any request. Each request that needs user presence shows a
# desktop notification the user has to approve. Other rules may still grant
# access through an ACL as they do for hardware keys: on Ubuntu, sssd's
# 90-sssd-token-access.rules gives the sssd user every security token's node,
# this one included.
#
# Browsers packaged as snaps (Firefox and Chromium on Ubuntu) can only open
# devices that udev tags for them: snapd's device cgroup admits a node tagged
# snap_<snap>_<app>. Its u2f-devices interface tags hardware keys by their USB
# vendor and product IDs, which a uhid device does not have, so this rule
# tags the node for the Firefox and Chromium snaps itself. The tags give a
# snap no more than the node's mode and ACL do. For another browser snap, add
# TAG+="snap_<snap>_<app>" with the names in its /etc/udev/rules.d/70-snap.*
# file.
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", DEVPATH=="/devices/virtual/misc/uhid/0003:1209:0001.*", \
  MODE="0600", TAG+="uaccess", TAG+="snap_firefox_firefox", TAG+="snap_chromium_chromium"

LABEL="pqkey_end"
